# Local demo defaults. Keep real bearer tokens in an OS secret manager/environment.
GHOST_AUDIT_MODE=development
GHOST_AUDIT_BEARER_TOKEN=
GHOST_AUDIT_AUTH_REQUIRED=
GHOST_AUDIT_CORS_ORIGINS=
GHOST_AUDIT_API_URL=http://api:8000
GHOST_AUDIT_MAX_UPLOAD_BYTES=52428800
GHOST_AUDIT_MAX_ZIP_ENTRIES=5000
GHOST_AUDIT_MAX_UNCOMPRESSED_BYTES=262144000
GHOST_AUDIT_TIMEOUT_SECONDS=300
GHOST_AUDIT_MAX_CONCURRENT=1
GHOST_AUDIT_RETENTION_HOURS=24
